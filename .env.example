# Exporta estas variables en el proceso o mediante tu gestor de secretos.
# El programa no carga .env automáticamente.
APP_ENV=development
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_SECRET_KEY: generar con secrets.token_urlsafe(64); obligatorio en producción.
# DATABASE_PATH=/ruta/privada/atigra.sqlite3
# DEMO_PASSWORD: solo para crear usuarios ficticios con APP_ENV=demo.
# INITIAL_ADMIN_PASSWORD: alternativa no interactiva a init_admin; no versionar.

# Sitio público HTTPS (también demo): DEBUG=0 y HTTPS_ONLY=1.
# No activar HTTPS_ONLY en localhost sin TLS.
HTTPS_ONLY=0

# Fijar estas rutas al cambiar de entorno si se conservan datos existentes.
# Los comandos de consola y WSGI deben usar los mismos valores.
# PRIVATE_MEDIA_ROOT=/ruta/privada/adjuntos
# PRACTICE_DATABASE_PATH=/ruta/privada/practicas.sqlite3

# Restringir temporalmente el sitio a retirada de datos por administración autorizada.
ERASURE_ONLY=0
