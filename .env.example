# Exporta estas variables en el proceso o mediante tu gestor de secretos.
# El programa no carga .env automáticamente.
APP_ENV=development
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_SECRET_KEY: generar con secrets.token_urlsafe(64); obligatorio en producción.
# DATABASE_PATH=/ruta/privada/atigra.sqlite3
# DEMO_PASSWORD: solo para crear usuarios ficticios con APP_ENV=demo.
# INITIAL_ADMIN_PASSWORD: alternativa no interactiva a init_admin; no versionar.
