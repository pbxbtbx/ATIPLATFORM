msgstr ""
"Enable voice help and save. Then press Listen to page help. It reads "
"navigation explanations, not names, contacts, notes or personal fields."

msgid "Activar ayudas de audiodescripción"
msgstr "Enable audio description help"

msgid "Ajustar medidas"
msgstr "Adjust dimensions"

msgid "Ajustes personales para leer, navegar y trabajar con más comodidad."
msgstr "Personal settings for more comfortable reading, navigation and work."

msgid "Alto contraste"
msgstr "High contrast"

